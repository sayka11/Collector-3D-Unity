using System.Collections;
using System.Collections.Generic;
using UnityEngine;

public class GemSpawner : MonoBehaviour
{
    public float SpawnRate = 2f;
    public GameObject[] Gem;
    public int GemCOUNT = 0;

    // Точные безопасные координаты платформы
    private float minX = -10.5f;
    private float maxX = 4.0f;
    private float minZ = -7.5f;
    private float maxZ = 7.5f;
    private float spawnHeight = 1f;

    private void Start()
    {
        for (int i = 0; i < GemCOUNT; i++)
        {
            SpawnRandomGem();
        }

        InvokeRepeating(nameof(SpawnRandomGem), 3f, SpawnRate);
    }

    private void SpawnRandomGem()
    {
        Vector3 randomPos = new Vector3(
            Random.Range(minX, maxX),
            spawnHeight,
            Random.Range(minZ, maxZ)
        );

        Instantiate(Gem[Random.Range(0, Gem.Length)], randomPos, Quaternion.identity);
    }
}
